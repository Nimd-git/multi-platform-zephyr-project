# Zephyr / west 构建产物
build/
*.dts_compiled
zephyr_modules.txt
app/build_all.log

# west 工作区本地配置与拉取的外部模块（由 west update 重建）
.west/
modules/

# 上游源码（不随本仓库提交；新环境克隆后由 west update 拉取）
# 注意：锚定到仓库根，仅忽略根级 RTOS 树；不要写成 "zephyr/"（会误伤
# platform/zephyr/ 等合法的模块 CMake 目录，导致平台模块逻辑无法进版本库）。
/zephyr/
bootloader/mcuboot/
tools/edtt/
tools/net-tools/

# Python
.venv/
__pycache__/
*.pyc

# 上游仓库历史备份（重命名自 .git，仅本地保留，不提交）
**/.git.upstream/

# 编辑器
.vscode/
.idea/
.trae/
