// SPDX-License-Identifier: Apache-2.0
//
// esp32c6_devkitc/esp32c6/hpcore（乐鑫 ESP32-C6-DevKitC-1，32 位 RISC-V HP 核）
// 板级设备树扩展：
//   - plat-led0：复用片上 gpio0 的 8 脚（DevKitC-1 板载 WS2812 RGB LED 数据线，
//                冒烟阶段按普通 GPIO 驱动；后续可切换 led_strip/WS2812 驱动）
//   - platform-monitor：自研骨架驱动实例（纯软件设备，验证 DT_INST 实例化链路）
//   - UART1：GPIO4(TX)/GPIO5(RX)，挂 Modbus RTU 主站（modbus0）
//   - fstab：LittleFS 挂载到 storage_partition（192KB @ 0x3b0000）
//
// gpio0 控制器节点由 zephyr/dts/riscv/espressif/esp32c6/esp32c6_common.dtsi 提供，
// 板级 esp32c6_devkitc_hpcore.dts 已将其 status = "okay"，此处直接引用。

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	aliases {
		plat-led0 = &plat_led0;
	};

	leds {
		compatible = "gpio-leds";
		plat_led0: plat-led0 {
			gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
		};
	};

	plat_monitor0: platform-monitor {
		compatible = "plat,platform-monitor";
		report-interval-ms = <1000>;
		status = "okay";
	};

	fstab {
		compatible = "zephyr,fstab";
		lfs0: lfs {
				compatible = "zephyr,fstab,littlefs";
				mount-point = "/lfs";
				partition = <&storage_partition>;
				read-size = <16>;
				prog-size = <16>;
				cache-size = <64>;
				lookahead-size = <32>;
				block-cycles = <512>;
				automount;
			};
	};
};

/* UART1：GPIO4(TX) / GPIO5(RX)，Modbus RTU 主站总线 */
&pinctrl {
	uart1_default: uart1_default {
		group1 {
			pinmux = <UART1_TX_GPIO4>;
		};
		group2 {
			pinmux = <UART1_RX_GPIO5>;
			bias-pull-up;
		};
	};
};

&uart1 {
	current-speed = <115200>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";
	status = "okay";

	modbus0: modbus0 {
		compatible = "zephyr,modbus-serial";
		status = "okay";
	};
};
